# =============================================================================
# nbytes environment template: names only, never real values.
# Copy to .env.local (git-ignored) and fill in. Read by Next.js, drizzle-kit
# and the npm db:* scripts (docker compose --env-file .env.local).
# =============================================================================

# --- Database (local Docker Postgres) -----------------------------------------
# Used by docker-compose to create the database on first start (empty volume only).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=

# --- App ----------------------------------------------------------------------
# Site origin, e.g. http://localhost:3000. Login requests from any other origin are refused.
APP_URL=

# --- Auth (PRD backend-auth-user §14) -----------------------------------------
# Secret keys: at least 32 random bytes, base64. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_OTP_PEPPER=
AUTH_HASH_KEY=
# Admin TOTP secrets are encrypted with this key (PRD backend-auth-admin §13): exactly 32 random bytes, base64,
# made with the same command. Changing it makes every admin enroll their authenticator again.
ADMIN_TOTP_KEY=
# Client-IP header set by your own trusted proxy (e.g. cf-connecting-ip).
# May stay empty in development only.
AUTH_TRUSTED_IP_HEADER=

# --- Email --------------------------------------------------------------------
# smtp    = send real mail through the SMTP settings below.
# console = print codes to the dev server log (NODE_ENV=development only).
EMAIL_PROVIDER=
# Sender shown to users, e.g. nbytes <no-reply@nbytes.id>.
# Must be an address your SMTP account is allowed to send from.
EMAIL_FROM=

# --- SMTP (required when EMAIL_PROVIDER=smtp) ---------------------------------
# Port 465 -> SMTP_SECURE=true (TLS from the start).
# Port 587 -> SMTP_SECURE=false (STARTTLS, enforced by the app).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- Payments: Sumopod Managed Payment (PRD gateway-pricing-billing §6.3) -------
# Sandbox and Live have separate values; never use Sandbox keys in production.
# API key from the Sumopod dashboard (Quick Start / Settings -> API Key).
SUMOPOD_API_KEY=
# Origin only. Sandbox: https://api-pay-sandbox.sumopod.com (Live URL: not documented yet).
SUMOPOD_API_BASE_URL=
# Settings -> Webhook -> Signing Secret ("whsec_..."). Webhook URL there: <APP_URL>/api/payments/sumopod/webhook
SUMOPOD_WEBHOOK_SECRET=

# --- AI gateway: Surplus Intelligence (PRD gateway-api §12) ---------------------
# Origin only, e.g. https://api.surplusintelligence.ai (the app adds /v1/...).
SURPLUS_BASE_URL=
# nbytes' own Surplus buyer key ("inf_..."). Server only; never shown to users.
SURPLUS_API_KEY=
# HMAC key for stored user API key hashes: at least 32 random bytes, base64 (same command as the auth keys).
# Changing it makes every user's API key stop working.
API_KEY_HASH_SECRET=
